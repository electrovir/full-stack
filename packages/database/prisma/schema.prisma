generator jsClient {
    provider        = "prisma-client-js"
    previewFeatures = ["strictUndefinedChecks", "driverAdapters"]
}

generator jsFrontend {
    provider = "prisma-frontend"
}

generator mappedClient {
    provider = "prisma-map"
    config   = "./prisma-map-config.ts"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id        String   @id @default(cuid(2))
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    /// Hashed and salted password.
    password                  String
    /// Email address is not unique because a user may deactivate their account and create a new one later.
    emailAddress              String
    /// If the user changes their email address, it gets saved here until they verify the new email address.
    unverifiedNewEmailAddress String?
    /// This must be kept in sync with the above `emailAddress` field. It is used to prevent multiple users with the same email but with different casing or other extra email bits.
    normalizedEmailAddress    String
    deactivatedAt             DateTime?
    accountVerifiedAt         DateTime?

    userActions UserAction[]
    emailCodes  EmailCode[]
}

enum EmailCodeType {
    /// Verifies the user's account before they can access anything.
    AccountVerification
    /// Verifies an email that the user is trying to change to.
    ChangedEmailVerification
    /// Verifies retting the user's password.
    PasswordReset
}

model EmailCode {
    id        String   @id @default(cuid(2))
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    /// hashed
    code         String
    codeType     EmailCodeType
    /// Indicates that this email code has been used. Codes cannot be used more than once.
    usedAt       DateTime?
    /// The email address that this code was sent to. This might not exactly match the related user's email because users can modify their email address.
    emailAddress String

    user   User   @relation(fields: [userId], references: [id], onUpdate: Restrict, onDelete: Restrict)
    userId String
}

enum UserActionType {
    SignUp
    Login
    EmailCodeSent
    EmailCodeVerified
    EmailCodeFailed
}

/// a log of all actions performed by all users
model UserAction {
    id        String   @id @default(cuid(2))
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    actionType    UserActionType
    /// A JSON object with extra, arbitrary details for this user action
    actionDetails Json?
    /// IP address of the user when they made the action
    userIpAddress String

    userId String
    user   User   @relation(fields: [userId], references: [id], onUpdate: Restrict, onDelete: Restrict)
}
