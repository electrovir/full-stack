{
    "name": "@evir/database",
    "private": true,
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "scripts": {
        "compile": "virmator compile",
        "db:gen": "rm -rf src/generated && prisma generate --no-hints && tsx src/prisma/prisma-map.script.ts",
        "db:reset": "rm -rf ../../.not-committed/dev",
        "postinstall": "db:gen || true",
        "start": "tsx src/index.ts",
        "test": "virmator test node",
        "test:coverage": "npm run test",
        "test:update": "npm test update"
    },
    "dependencies": {
        "@augment-vir/assert": "^31.20.0",
        "@augment-vir/common": "^31.20.0",
        "@augment-vir/node": "^31.20.0",
        "@prisma/client": "^6.8.2",
        "auth-vir": "^1.2.1",
        "date-vir": "^7.3.1",
        "prisma": "^6.8.2",
        "prisma-map": "^2.0.3",
        "prisma-pglite": "^0.1.0",
        "url-vir": "^2.1.3"
    },
    "devDependencies": {
        "@augment-vir/test": "^31.20.0",
        "@types/node": "^22.15.21",
        "type-fest": "^4.41.0"
    },
    "engines": {
        "node": ">=22"
    }
}
