{
    "name": "@evir/database",
    "private": true,
    "sideEffects": false,
    "type": "module",
    "scripts": {
        "compile": "virmator compile",
        "db:gen": "node -e \"require('fs').rmSync('src/generated', { recursive: true, force: true })\" && prisma generate --no-hints",
        "db:reset": "node -e \"require('fs').rmSync(require('path').resolve(__dirname, '..', '..', '.not-committed', 'db'), { recursive: true, force: true })\"",
        "postinstall": "db:gen || true",
        "prisma": "npm run prisma --prefix ../common-backend",
        "start": "tsx src/index.ts",
        "test": "virmator test node && virmator test web src/for-frontend.test.web.ts",
        "test:all": "npm run test && npm run prisma --prefix ../.. dev validate"
    },
    "dependencies": {
        "@augment-vir/assert": "^31.68.1",
        "@augment-vir/common": "^31.68.1",
        "@prisma/client": "^6.19.0",
        "date-vir": "^8.2.1",
        "object-shape-tester": "^6.11.0",
        "prisma-vir": "^2.3.3",
        "type-fest": "^5.4.4"
    },
    "devDependencies": {
        "@augment-vir/test": "^31.68.1",
        "@web/dev-server-esbuild": "^1.0.5",
        "@web/test-runner": "^0.20.2",
        "@web/test-runner-commands": "^0.9.0",
        "@web/test-runner-playwright": "^0.11.1",
        "@web/test-runner-visual-regression": "^0.10.0",
        "istanbul-smart-text-reporter": "^1.1.5"
    },
    "engines": {
        "node": ">=22"
    }
}
