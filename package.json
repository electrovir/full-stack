{
    "name": "@evir/mono-root",
    "private": true,
    "homepage": "https://github.com/electrovir/full-stack",
    "bugs": {
        "url": "https://github.com/electrovir/full-stack/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/full-stack.git"
    },
    "license": "(MIT or CC0 1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build:backend": "npm run compile && tsx node_modules/@augment-vir/node/src/scripts/fix-src-imports.script.ts",
        "build:frontend": "npm run build --workspace @evir/frontend",
        "compile": "npm run init && virmator compile",
        "deploy": "npm run deploy --workspace @evir/scripts",
        "dev": "bash packages/scripts/src/run-dev.sh",
        "format": "virmator format",
        "fresh": "npm run init && bash packages/scripts/src/run-dev.sh",
        "init": "npm run install --prefix node_modules/better-sqlite3 && npm run --workspace @evir/database db:gen && npm run --workspace @evir/database db:reset",
        "lint": "virmator lint fix",
        "prisma": "npx tsx packages/common-backend/src/backend-client-interface/clients/prisma/prisma.script.ts",
        "start": "npm ci && npm run init && npm run dev",
        "test": "npm test --workspace=@evir/e2e && mono-vir for-each-async npm run test:all",
        "test:all": "npm run compile && runstorm --names tests,spelling,format,deps,lint \"npm run test:spelling\" \"npm run test:format\" \"npm run test:deps\" \"npm run test:lint\" && npm run test",
        "test:deps": "virmator deps check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "mono-vir for-each-async npm run test:update"
    },
    "overrides": {
        "@playwright/test": "1.56.1",
        "playwright": "1.56.1"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^9.39.2",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@typescript-eslint/eslint-plugin": "^8.57.0",
        "cspell": "^9.7.0",
        "dependency-cruiser": "^17.3.8",
        "esbuild": "^0.27.3",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^62.7.1",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.9.0",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^4.0.2",
        "eslint-plugin-unicorn": "^63.0.0",
        "mono-vir": "^2.5.0",
        "npm-check-updates": "^19.6.3",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.1",
        "prettier-plugin-jsdoc": "^1.8.0",
        "prettier-plugin-multiline-arrays": "^4.1.5",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^3.0.2",
        "prettier-plugin-sort-json": "^4.2.0",
        "prettier-plugin-toml": "^2.0.6",
        "runstorm": "^1.0.0",
        "typescript-eslint": "^8.57.0",
        "virmator": "^14.9.0"
    },
    "engines": {
        "node": ">=22"
    }
}
